{
  "name": "song-app",
  "version": "1.1.1",
  "private": true,
  "description": "A Windows-first Spotify desktop music companion.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "typecheck": "tsc --noEmit",
    "audit": "npm run test && npm run typecheck && node scripts/audit.mjs",
    "check:release": "node scripts/check-release.mjs",
    "package:win": "npm run build && npm run check:release && electron-builder --win nsis portable",
    "test:integration": "node --test tests/core/*.node.mjs",
    "verify": "npm run test && npm run typecheck && npm run test:integration && npm run build && node scripts/audit.mjs",
    "check:features": "node scripts/check-feature-matrix.mjs",
    "verify:windows": "powershell -ExecutionPolicy Bypass -File .\\scripts\\verify-windows.ps1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.songapp.desktop",
    "productName": "Song App",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Song-App-${version}-${arch}.${ext}",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": true
  }
}
